Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Примусовий HTTPS (діє локально і на хостингу)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteCond %{REQUEST_URI} /app/|/storage/|/bin/|/migrations/|config
  RewriteRule ^ - [F]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "\.(sqlite|log|md|lock)$">
  Require all denied
</FilesMatch>
